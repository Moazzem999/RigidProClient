@model ErrorViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Error - ZamZam Trims (BD) Ltd.";
}

<div class="container py-4 my-auto">
    <div class="row justify-content-center">
        <div class="col-11 col-sm-9 col-md-7 col-lg-5 col-xl-4">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden auth-card text-center p-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem;"></i>
                </div>
                <h4 class="fw-bold font-heading mb-2">Something went wrong</h4>
                <p class="text-muted small mb-3">An error occurred while processing your request.</p>

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-light border small text-muted text-break mb-3">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </div>
                }

                <a asp-controller="Account" asp-action="Login" class="btn btn-modern-primary rounded-pill mt-2">
                    <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>
